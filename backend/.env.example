# Copy to backend/.env and adjust. Every value is optional; defaults target a local setup.

# MongoDB connection
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=api_endpoint_testing

# Comma-separated origins allowed to call the API (the dashboard URL)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email alerts and health reports via Resend (https://resend.com).
# Without an API key, alerts are skipped and logged instead of sent.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Recipient for the delivery check: python -m app.services.resend_service
RESEND_TEST_RECIPIENT=
